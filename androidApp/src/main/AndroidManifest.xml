<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<!-- needed for obvious reasons, network state is for checking if offline -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

	<!-- needed for the equaliser feature, for some reason -->
	<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

	<!-- needed for widgets (glance automatically adds these but just putting this here to be explicit) -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

	<!-- needed for the playback service and widgets -->
	<uses-permission
		android:name="android.permission.FOREGROUND_SERVICE"
		tools:ignore="ForegroundServicesPolicy" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<!-- Needed so a download survives the app being backgrounded. Without a
	     foreground service the process drops to CACHED when the last Activity stops
	     and Android 12+ freezes its threads mid-transfer, which is what made
	     downloading a large playlist require keeping the app on screen. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

	<!-- Download and library-sync progress notifications (upstream), and lb-bot fill
	     outcomes (see FillNotifier). Playback's own notification rides on the media
	     session's foreground service and needs nothing here. Requested through
	     PermissionManager.requestNotificationsPermission() — one launcher, not two. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<permission
		android:name="${applicationId}.permission.PLAYBACK_SERVICE"
		android:protectionLevel="signature" />
	<uses-permission android:name="${applicationId}.permission.PLAYBACK_SERVICE" />

	<application
		android:name=".Application"
		android:allowBackup="true"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:fullBackupContent="@xml/backup_rules"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:localeConfig="@xml/locales_config"
		android:networkSecurityConfig="@xml/network_security_config"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:largeHeap="true"
		android:theme="@style/Theme.Navic"
		android:usesCleartextTraffic="true"
		tools:targetApi="33">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:theme="@style/Theme.Navic">
			<!-- Paste-a-link, via the system share sheet: a streaming URL shared from
			     a browser or another music app is resolved to MusicBrainz ids by
			     lb-bot and opened as the release it names.

			     ON THE ACTIVITY, NOT ON EITHER activity-alias BELOW. Those two exist
			     solely to swap the launcher icon and one of them is always disabled,
			     so a filter there would be dead half the time and a duplicate entry
			     in the share sheet the other half. -->
			<intent-filter>
				<action android:name="android.intent.action.SEND" />
				<category android:name="android.intent.category.DEFAULT" />
				<data android:mimeType="text/plain" />
			</intent-filter>
		</activity>

		<!-- app icon activities -->
		<activity-alias
			android:name="${applicationId}.MainActivityDefault"
			android:enabled="true"
			android:exported="true"
			android:icon="@mipmap/ic_launcher"
			android:label="@string/app_name"
			android:roundIcon="@mipmap/ic_launcher_round"
			android:targetActivity=".MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name="${applicationId}.MainActivityInverted"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_launcher_inverted"
			android:label="@string/app_name"
			android:roundIcon="@mipmap/ic_launcher_inverted_round"
			android:targetActivity=".MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<!-- misc activities -->
		<activity
			android:name=".CrashActivity"
			android:exported="false"
			android:process=":crash"
			android:theme="@style/Theme.Navic" />

		<service
			android:name="paige.navic.shared.PlaybackService"
			android:enabled="true"
			android:exported="true"
			android:foregroundServiceType="mediaPlayback">
			<!--			android:permission="${applicationId}.permission.PLAYBACK_SERVICE">   : Blocks android auto from seeing the app at all? -->
			<intent-filter>

				<action android:name="androidx.media3.session.MediaSessionService" />
				<action android:name="androidx.media3.session.MediaLibraryService" />
				<action android:name="android.media.browse.MediaBrowserService" />
			</intent-filter>
		</service>

		<!-- Downloads. Declared here rather than in :composeApp, which is a KMP
		     library module and has no manifest of its own — same reason
		     PlaybackService above is declared here while its class lives there.
		     Not exported: it is started only by DownloadForegroundController. -->
		<service
			android:name="paige.navic.shared.DownloadService"
			android:enabled="true"
			android:exported="false"
			android:foregroundServiceType="dataSync" />

		<!-- miniplayer receiver -->
		<receiver
			android:name=".widgets.miniplayer.MiniPlayerReceiver"
			android:exported="false"
			android:label="Mini Player">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
				<action android:name="${applicationId}.NOW_PLAYING_UPDATED" />
			</intent-filter>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/mini_player_widget" />
		</receiver>

		<!-- turn table receiver -->
		<receiver
			android:name=".widgets.turntable.TurnTableReceiver"
			android:exported="false"
			android:label="Turn Table">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
				<action android:name="${applicationId}.NOW_PLAYING_UPDATED" />
			</intent-filter>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/turn_table_widget" />
		</receiver>

		<!-- quick picks receiver -->
		<receiver
			android:name=".widgets.quickpicks.QuickPicksReceiver"
			android:exported="false"
			android:label="Quick Picks">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
				<action android:name="${applicationId}.NOW_PLAYING_UPDATED" />
			</intent-filter>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/quick_picks_widget" />
		</receiver>

		<!-- Widget skip buttons. media3's MediaButtonReceiver below drops every key event that
		     isn't a play command on API 26+, so next/previous go through a MediaController
		     instead — see WidgetControlReceiver. Addressed by explicit component, hence no
		     intent-filter. -->
		<receiver
			android:name=".widgets.nowplaying.WidgetControlReceiver"
			android:exported="false" />

		<!-- needed for widgets to control playback -->
		<receiver
			android:name="androidx.media3.session.MediaButtonReceiver"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MEDIA_BUTTON" />
			</intent-filter>
		</receiver>

		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>

		<!-- Android Auto -->
		<meta-data
			android:name="com.google.android.gms.car.application"
			android:resource="@xml/automotive_app_desc" />
		<meta-data
			android:name="androidx.car.app.TintableAttributionIcon"
			android:resource="@drawable/ic_navic" />
	</application>
</manifest>

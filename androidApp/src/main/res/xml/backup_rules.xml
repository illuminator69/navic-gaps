<?xml version="1.0" encoding="utf-8"?><!--
   Android auto-backup rules (API 30 and below; API 31+ uses data_extraction_rules.xml).

   Everything the app stores in preferences lives in ONE file, and that file holds the
   Navidrome password, the hub token and the AudioMuse token. Backup would copy them to
   Google's servers and onto whatever device a restore lands on, which is not somewhere a
   self-hosted setup's credentials should end up by default.

   Multiplatform-Settings' `Settings()` factory maps to the default SharedPreferences
   file, i.e. <applicationId>_preferences.xml — "paige.navic" here, plus the ".debug"
   suffix on debug builds, so both are named.

   The trade is real and deliberate: a restored install asks for the server details again.
   Cached library data lives in the Room databases and is re-syncable, so it is excluded
   too rather than dragging a stale copy of the library onto a new device.
-->
<full-backup-content>
	<exclude
		domain="sharedpref"
		path="paige.navic_preferences.xml" />
	<exclude
		domain="sharedpref"
		path="paige.navic.debug_preferences.xml" />
	<exclude
		domain="database"
		path="cache.db" />
	<exclude
		domain="database"
		path="downloads.db" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for API 31+. See backup_rules.xml for the same policy on older
   devices, and for why the preferences file is excluded: it is the single file holding the
   Navidrome password, the hub token and the AudioMuse token.

   cloud-backup and device-transfer are separated on purpose. A cloud backup leaves the
   user's hardware entirely, so credentials and cached library both stay out of it. A
   device-transfer is a direct handset-to-handset copy the user initiated, where carrying
   the credentials across is the behaviour they are asking for; the re-syncable library
   caches are still left behind rather than moved as a stale snapshot.
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude
			domain="sharedpref"
			path="paige.navic_preferences.xml" />
		<exclude
			domain="sharedpref"
			path="paige.navic.debug_preferences.xml" />
		<exclude
			domain="database"
			path="cache.db" />
		<exclude
			domain="database"
			path="downloads.db" />
	</cloud-backup>
	<device-transfer>
		<exclude
			domain="database"
			path="cache.db" />
		<exclude
			domain="database"
			path="downloads.db" />
	</device-transfer>
</data-extraction-rules>
